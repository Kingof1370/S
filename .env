# Server
NODE_ENV=production
PORT=3000
NEXTAUTH_URL=https://nexuspay.io
NEXTAUTH_SECRET=your-nextauth-secret

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/nexuspay
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# JWT
JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# TRON
TRON_API_KEY=your-tron-api-key
TRON_MAIN_WALLET_ADDRESS=your-wallet-address
TRON_MAIN_PRIVATE_KEY=your-private-key
TRON_NETWORK=mainnet
TRON_CONFIRMATIONS_NEEDED=19
TRON_GRID_API_URL=https://api.trongrid.io
TRON_SCAN_URL=https://tronscan.org

# Price API
COINGECKO_API_KEY=your-coingecko-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
PRICE_REFRESH_INTERVAL=10000

# Email
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@nexuspay.io
SENDGRID_TEMPLATE_WELCOME=template-id-1
SENDGRID_TEMPLATE_DEPOSIT=template-id-2
SENDGRID_TEMPLATE_WITHDRAW=template-id-3
SENDGRID_TEMPLATE_BONUS=template-id-4

# Admin
ADMIN_EMAILS=admin@nexuspay.io
ADMIN_PASSWORD_HASH=your-hashed-password

# Security
BCRYPT_ROUNDS=12
TWO_FACTOR_APP_NAME=NexusPay
ENCRYPTION_KEY=your-encryption-key
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Rate Limits
GLOBAL_RATE_LIMIT=100
AUTH_RATE_LIMIT=5
WITHDRAW_RATE_LIMIT=3
DEPOSIT_RATE_LIMIT=10

# Queue
BULL_REDIS_URL=redis://localhost:6379
BULL_PREFIX=nexuspay

# Monitoring
SENTRY_DSN=your-sentry-dsn
WINSTON_LOG_LEVEL=info

# Feature Flags
ENABLE_PROP_TRADING=true
ENABLE_BONUS_CALCULATOR=true
ENABLE_LIVE_TICKER=true
ENABLE_3D_DASHBOARD=true

# CDN
IMAGE_CDN_URL=https://cdn.nexuspay.io

# CORS
CORS_ORIGIN=https://nexuspay.io
